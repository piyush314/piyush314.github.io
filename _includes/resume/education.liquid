<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign education = data[1] | sort: 'startDate' | reverse %}
  {% for content in education %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-3 col-md-3 text-center">
          {% if content.startDate and content.startDate != '' %}
            {% assign startYear = content.startDate | split: '-' | first %}
            {% assign endYear = content.endDate | split: '-' | first %}
            {% if endYear != '' and startYear == endYear %}
              {% assign date = endYear %}
            {% else %}
              {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
              {% assign endDate = content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
              {% assign date = startDate | append: ' - ' | append: endDate %}
            {% endif %}
          {% else %}
            {% assign date = null %}
          {% endif %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  {% if date %}
                    <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ date }} </span>
                  {% endif %}
                </td>
              </tr>
              {% if content.location %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ content.location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-9 col-md-9 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4">
            {% if content.url and content.url != '' %}
              <a href="{{ content.url }}">{{ content.studyType }}</a>
            {% else %}
              {{ content.studyType }}
            {% endif %}
          </h6>
          {% if content.institution and content.institution != '' %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem">{{ content.institution }}</h6>
          {% endif %}
          {% if content.area and content.area != '' %}
            <h6 class="ml-1 ml-md-4" style="font-size: 0.95rem; font-style: italic">{{ content.area }}</h6>
          {% endif %}
          {% if content.score and content.score != '' %}
            <p class="ml-1 ml-md-4 mb-1">{{ content.score }}</p>
          {% endif %}
          {% if content.details and content.details.size > 0 %}
            <ul class="items">
              {% for item in content.details %}
                <li><span class="item">{{ item }}</span></li>
              {% endfor %}
            </ul>
          {% endif %}
          <ul class="items">
            {% for item in content.courses %}
              <li>
                <span class="item">{{ item }}</span>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
